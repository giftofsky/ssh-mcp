{
  "name": "ssh-mcp",
  "version": "0.1.0",
  "description": "MCP server: persistent OpenSSH sessions with local-tool-equivalent remote file/exec tools",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.10.4",
    "typescript": "5.6.3",
    "zod": "^3"
  },
  "scripts": {
    "build": "tsc -p .",
    "run": "node dist/src/server/index.js",
    "dist:ssh-mcp": "pnpm build && pnpm run",
    "test": "pnpm build && node --test \"dist/tests/*.test.js\""
  }
}
